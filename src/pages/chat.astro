---
import Layout from "../layouts/Layout.astro";
import "../styles/chat.css";
---

<Layout
  title="Chat - SparksLyse"
  description="Chatbot de démonstration SparksLyse"
  ogImage="images/ogImage.jpg"
>
  <main class="chat-shell">
    <div class="chat-intro">
      <h1 class="chat-title">
        Discutez avec <span class="dim">SparksLyse</span>
      </h1>
    </div>

    <div class="chat-messages" id="chat-messages"></div>

    <div class="chat-composer">
      <form id="composer-form">
        <div class="composer-card">
          <label class="sr-only" for="composer-input">Votre prompt</label>
          <textarea
            id="composer-input"
            rows="1"
            placeholder="Écrivez votre prompt (question)…"
            autocomplete="off"></textarea>

          <div class="composer-toolbar">
            <div class="composer-tools">
              <span class="tool-pill" title="À venir">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                  <path d="M3 9h18"></path>
                </svg>

                <span>Bibliothèque</span>
              </span>

              <button class="tool-icon" type="button" title="À venir" disabled>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 12.5V7a2 2 0 0 0-2-2H8L4 9v10a2 2 0 0 0 2 2h6"
                  ></path>
                  <path d="M4 9h4V5"></path>
                </svg>
              </button>

              <button class="tool-icon" type="button" title="À venir" disabled>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <path d="M21 15l-5-5-4 4-2-2-4 4"></path>
                </svg>
              </button>

              <button class="tool-icon" type="button" title="À venir" disabled>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"
                  ></path>
                  <path d="M19 10v1a7 7 0 0 1-14 0v-1"></path>
                  <path d="M12 18v4"></path>
                </svg>
              </button>
            </div>

            <button class="send-btn" id="send-btn" type="submit" disabled>
              <span class="send-icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="12" y1="19" x2="12" y2="5"></line>
                  <polyline points="6 11 12 5 18 11"></polyline>
                </svg>
              </span>
              <span class="send-loading" aria-hidden="true">
                <div class="loading-square"></div>
              </span>
            </button>
          </div>
        </div>
      </form>

      <div class="composer-hint">
        <span>Entrée pour envoyer · Maj+Entrée pour une nouvelle ligne</span>

        <button class="clear-btn" id="clear-btn" type="button">
          Effacer la conversation
        </button>
      </div>
      <p class="privacy-note">
        <span class="privacy-note-content">
          Les messages sont transmis à l’API SparksLyse pour générer une réponse et ne sont pas conservés dans cette interface.
        </span>
        <a href={`${import.meta.env.BASE_URL}politique-confidentialite`}>Voir la politique de confidentialité</a>.
      </p>
    </div>
  </main>
</Layout>

<script>
  type Role = "user" | "assistant" | "system";

  interface Message {
    role: Role;
    content: string;
  }

  interface Elements {
    messages: HTMLDivElement;
    form: HTMLFormElement;
    input: HTMLTextAreaElement;
    sendButton: HTMLButtonElement;
    clearButton: HTMLButtonElement;
  }

  interface State {
    history: Message[];
    sending: boolean;
  }

  const elements: Partial<Elements> = {};

  const state: State = {
    history: [],
    sending: false,
  };

  const ICONS: Record<Role, string> = {
    user: "",

    assistant: `
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3c.6 2.8 1.6 3.8 4.4 4.4-2.8.6-3.8 1.6-4.4 4.4-.6-2.8-1.6-3.8-4.4-4.4C10.4 6.8 11.4 5.8 12 3z"></path>
        <path d="M18.5 14c.35 1.6.9 2.15 2.5 2.5-1.6.35-2.15.9-2.5 2.5-.35-1.6-.9-2.15-2.5-2.5 1.6-.35 2.15-1.6 2.5-2.5z"></path>
      </svg>
    `,

    system: `
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <line x1="12" y1="8" x2="12" y2="8.01"></line>
        <line x1="12" y1="11" x2="12" y2="16"></line>
      </svg>
    `,
  };

  function getElements(): Elements {
    const messages = document.getElementById("chat-messages");
    const form = document.getElementById("composer-form");
    const input = document.getElementById("composer-input");
    const sendButton = document.getElementById("send-btn");
    const clearButton = document.getElementById("clear-btn");

    if (
      !(messages instanceof HTMLDivElement) ||
      !(form instanceof HTMLFormElement) ||
      !(input instanceof HTMLTextAreaElement) ||
      !(sendButton instanceof HTMLButtonElement) ||
      !(clearButton instanceof HTMLButtonElement)
    ) {
      throw new Error("Impossible d'initialiser l'interface du chat.");
    }

    return {
      messages,
      form,
      input,
      sendButton,
      clearButton,
    };
  }

  function escapeHtml(value: string): string {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function renderText(value: string): string {
    return escapeHtml(value)
      .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
      .replace(/\n/g, "<br>");
  }

  function scrollToBottom(): void {
    const messages = elements.messages;

    if (!messages) return;

    messages.scrollTop = messages.scrollHeight;
  }

  async function streamChatAPI(
    onChunk: (text: string) => void,
  ): Promise<string> {
    const response = await fetch("https://marvideo.fr/lyseai-api/chat.php", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "text/event-stream",
      },
      body: JSON.stringify({
        messages: state.history,
      }),
    });

    if (!response.ok) {
      const errorText = await response.text();

      throw new Error(`API ${response.status}: ${errorText}`);
    }

    if (!response.body) {
      throw new Error("Le navigateur ne supporte pas ReadableStream.");
    }

    const reader = response.body.getReader();

    const decoder = new TextDecoder("utf-8");

    let buffer = "";
    let fullResponse = "";

    while (true) {
      const { done, value } = await reader.read();

      if (done) {
        break;
      }
      const chunk = decoder.decode(value, {
        stream: true,
      });

      buffer += chunk;

      buffer = buffer.replace(/\r\n/g, "\n");

      const events = buffer.split("\n\n");

      buffer = events.pop() ?? "";

      for (const event of events) {
        const lines = event.split("\n");

        for (const line of lines) {
          const trimmed = line.trim();

          if (!trimmed.startsWith("data:")) {
            continue;
          }

          const data = trimmed.slice(5).trim();

          if (!data || data === "[DONE]") {
            continue;
          }

          try {
            const json = JSON.parse(data);

            const token =
              json?.choices?.[0]?.delta?.content ??
              json?.choices?.[0]?.message?.content ??
              json?.message?.content ??
              json?.content ??
              "";

            if (typeof token !== "string" || !token) {
              continue;
            }

            fullResponse += token;

            onChunk(token);
          } catch {
          }
        }
      }
    }

    buffer += decoder.decode();

    buffer = buffer.replace(/\r\n/g, "\n");

    for (const line of buffer.split("\n")) {
      const trimmed = line.trim();

      if (!trimmed || !trimmed.startsWith("data:")) {
        continue;
      }

      const data = trimmed.slice(5).trim();

      if (!data || data === "[DONE]") {
        continue;
      }

      try {
        const json = JSON.parse(data);

        const token =
          json?.choices?.[0]?.delta?.content ??
          json?.choices?.[0]?.message?.content ??
          json?.message?.content ??
          json?.content ??
          "";

        if (typeof token === "string" && token) {
          fullResponse += token;
          onChunk(token);
        }
      } catch {
      }
    }

    return fullResponse;
  }

  function createMessageElement(message: Message): HTMLDivElement {
    const { role, content } = message;

    const wrapper = document.createElement("div");

    wrapper.className = "flex gap-3 max-w-full animate-fade-in";

    if (role === "user") {
      wrapper.classList.add("flex-row-reverse", "ml-auto");
    }

    const avatar = document.createElement("div");

    avatar.className =
      "shrink-0 w-7 h-7 rounded-lg border border-white/20 " +
      "flex items-center justify-center text-white/70";

    if (role === "user") {
      avatar.classList.add("hidden");
    }

    if (role === "system") {
      avatar.classList.add("text-[#858585]");
    }

    avatar.innerHTML = ICONS[role];

    const bubble = document.createElement("div");

    bubble.className =
      "border border-white/10 rounded-[20px] p-3.5 px-4 " +
      "text-[14.5px] leading-relaxed max-w-[620px]";

    if (role === "user") {
      bubble.classList.add(
        "bg-white/[0.05]",
        "border-white/20",
        "text-white",
        "rounded-tr-md",
      );
    } else if (role === "system") {
      bubble.classList.add(
        "bg-transparent",
        "border-dashed",
        "text-[#858585]",
        "text-xs",
      );
    } else {
      bubble.classList.add("bg-[#121212]", "rounded-tl-md");
    }

    const paragraph = document.createElement("p");

    paragraph.className = "m-0";

    paragraph.innerHTML = renderText(content);

    bubble.appendChild(paragraph);
    wrapper.append(avatar, bubble);

    return wrapper;
  }

  function addMessage(message: Message): void {
    const messages = elements.messages;

    if (!messages) return;

    messages.appendChild(createMessageElement(message));

    scrollToBottom();
  }

  function autoGrow(): void {
    const input = elements.input;

    if (!input) return;

    input.style.height = "auto";
    input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
  }

  function setSending(sending: boolean): void {
    state.sending = sending;
    
    const sendButton = elements.sendButton;
    if (!sendButton) return;

    sendButton.setAttribute("aria-busy", String(sending));

    updateSendButtonState();
  }

  async function handleSubmit(event: SubmitEvent): Promise<void> {
    event.preventDefault();

    if (state.sending) {
      return;
    }

    const input = elements.input;

    if (!input) {
      return;
    }

    const content = input.value.trim();

    if (!content) {
      return;
    }

    setSending(true);

    input.value = "";
    autoGrow();

    const userMessage: Message = {
      role: "user",
      content,
    };

    state.history.push(userMessage);
    addMessage(userMessage);

    scrollToBottom();

    const assistantMessage: Message = {
      role: "assistant",
      content: "",
    };

    const assistantElement = createMessageElement(assistantMessage);
    try {
      elements.messages?.appendChild(assistantElement);

      const bubble = assistantElement.querySelector("div:nth-child(2)");

      const paragraph = bubble?.querySelector("p");

      if (!paragraph) {
        throw new Error("Impossible de créer la réponse du chatbot.");
      }

      const reply = await streamChatAPI((chunk) => {
        assistantMessage.content += chunk;

        paragraph.innerHTML = renderText(assistantMessage.content);

        scrollToBottom();
      });

      assistantMessage.content = reply;

      paragraph.innerHTML = renderText(reply);

      state.history.push(assistantMessage);
    } catch (error: unknown) {
      const message =
        error instanceof Error
          ? error.message
          : "Une erreur inconnue est survenue.";

      const bubble = assistantElement.querySelector("div:nth-child(2)");

      const paragraph = bubble?.querySelector("p");

      if (!paragraph) {
        throw new Error("Impossible de créer la réponse du chatbot.");
      }

      paragraph.innerHTML = `Erreur inattendue côté client : ${message}`
    } finally {
      setSending(false);
      input.focus();
    }
  }

  function addWelcomeMessage(): void {
    addMessage({
      role: "assistant",
      content: "Bonjour 👋 Je suis SparksLyse !",
    });
  }

  function clearConversation(): void {
    const messages = elements.messages;

    if (!messages) return;

    state.history.length = 0;

    messages.replaceChildren();

    addMessage({
      role: "system",
      content: "Conversation réinitialisée.",
    });

    addWelcomeMessage();
  }

  function handleInputKeydown(event: KeyboardEvent): void {
    if (event.key !== "Enter" || event.shiftKey || event.isComposing) {
      return;
    }

    event.preventDefault();

    elements.form?.requestSubmit();
  }

  function bindEvents(): void {
    const { form, input, clearButton } = elements as Elements;

    form.addEventListener("submit", handleSubmit);

    input.addEventListener("input", () => {
      autoGrow();
      updateSendButtonState();
    });

    input.addEventListener("input", autoGrow);

    input.addEventListener("keydown", handleInputKeydown);

    clearButton.addEventListener("click", clearConversation);
  }

  async function init(): Promise<void> {
    Object.assign(elements, getElements());

    bindEvents();

    addWelcomeMessage();

    elements.input?.focus();
    autoGrow();

    updateSendButtonState(); 
  }


  function updateSendButtonState(): void {
    const input = elements.input;
    const sendButton = elements.sendButton;

    if (!input || !sendButton) return;

    const isEmpty = input.value.trim().length === 0;
    
    if (isEmpty || state.sending) {
      sendButton.disabled = true;
    } else {
      sendButton.disabled = false;
    }
  }
  

  void init();
</script>
