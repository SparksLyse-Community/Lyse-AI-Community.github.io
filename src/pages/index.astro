---
import Layout from "../layouts/Layout.astro";
import FeatureTab from "../components/FeatureTab";
import HowItWorksTab from "../components/HowItWorksTab";
import BenefitsCards from "../components/BenefitsCards";
import FAQs from "../components/FAQs";

import FadeInBlurWord from "../components/animation/FadeInBlurWord";

// Images
import headerImage from "../assets/images/header.png";

import Image from "astro/components/Image.astro";
import AboutCards from "../components/AboutCards";
import Button from "@/components/ui/Button";

const benefits: { title: string; description: string; logo: number }[] = [
  {
    title: "le temps est inversé",
    description:
      "Automatisez les tâches routinières et libérez du temps facilement.",
    logo: 0,
  },
  {
    title: "Des mots en toute simplicité",
    description:
      "Transformez vos idées en écrits soignés — clairs, naturels et rapides.",
    logo: 1,
  },
  {
    title: "Mise au point guidée",
    description:
      "Restez concentré grâce à des incitations douces qui éloignent les distractions.",
    logo: 2,
  },
  {
    title: "Connaissance instantanée",
    description:
      "Condensez vos recherches et vos analyses en informations claires.",
    logo: 3,
  },
  {
    title: " Toujours disponible",
    description:
      "Votre partenaire discret, prêt à vous aider dès que vous en avez besoin.",
    logo: 4,
  },
  {
    title: "Confiance intégrée",
    description:
      "Protection dès la conception — vos données, vos idées, toujours en sécurité.",
    logo: 5,
  },
];
---

<Layout
  title="SparksLyse, l'IA Open-Source"
  description="Quand l'IA rencontre l'Open-Source"
>
  <main>
    <header
      id="hero"
      class="relative flex min-h-screen w-full flex-col items-center justify-center gap-20 overflow-hidden px-4 pb-16 md:pb-24"
    >
      <div
        class="relative z-10 flex w-full max-w-137.5 flex-col items-center gap-8 text-center"
      >
        <div class="flex w-full flex-col items-center gap-4">
          <FadeInBlurWord
            as="h1"
            content={[{ text: "Quand l'IA rencontre l'Open-Source" }]}
            className="font-sans justify-center text-[40px] font-normal leading-[1.2] tracking-[-0.03em] text-white sm:text-[48px] lg:text-[56px] text-center"
            client:load
          />
          <FadeInBlurWord
            as="p"
            content={[
              {
                text: "Une IA open-source pour vous aider à y voir plus clair",
              },
            ]}
            className="text-center text-sm leading-[1.3] text-white/90 sm:text-base"
            client:load
          />
        </div>

        <Button variant="primary" href="#about">Commencer</Button>
      </div>

      <Button
        href={`${import.meta.env.BASE_URL}#about`}
        className="absolute bottom-1/6 left-1/2 z-10 -translate-x-1/2 text-xs tracking-wide text-white/55 transition hover:text-white"
        >Descendez pour voir</Button
      >

      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(232,255,156,0.07),transparent_38%)]"
      >
      </div>
      <div>
        <div
          class="z-1 flex-none w-full h-full absolute top-0 left-0 overflow-hidden"
          style="will-change: transform; opacity: 1; transform: scale(1.05)"
        >
          <div
            style="
				position: absolute;
				border-radius: inherit;
				corner-shape: inherit;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				"
          >
            <Image
              decoding="async"
              width="2912"
              height="1632"
              src={headerImage}
              aria-hidden="true"
              alt=""
              style="
					width: 100%;
					height: 100%;
					border-radius: inherit;
					corner-shape: inherit;
					object-position: center;
					object-fit: cover;
				"
            />
          </div>
        </div>
      </div>
    </header>

    <section
      id="about"
      class="mx-auto flex w-full max-w-300 flex-col gap-16 px-6 py-24 md:px-10 md:py-32 lg:px-16"
    >
      <div class="grid gap-8 lg:grid-cols-[1.05fr_1fr] lg:items-end">
        <div>
          <span
            class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
            >À propos</span
          >
          <FadeInBlurWord
            as="h2"
            content={[
              {
                text: "Exploitez une puissance pour écrire plus vite, mieux vous concentrer et gagner des heures.",
              },
            ]}
            className="max-w-2xl font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl justify-start"
            client:load
          />
        </div>
      </div>
      <AboutCards client:load />
    </section>

    <section
      id="features"
      class="mx-auto w-full max-w-300 px-6 py-24 md:px-10 md:py-32 lg:px-16"
    >
      <div class="mb-14 max-w-2xl">
        <span
          class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
          >Différents cas</span
        >
        <FadeInBlurWord
          as="h2"
          className="font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
          content={[
            { text: "Différents chemins à explorer, " },
            {
              text: "tous guidés par un compagnon silencieux.",
              style: { color: "rgb(133, 133, 133)" },
            },
          ]}
          client:load
        />
      </div>

      <FeatureTab client:load />
    </section>

    <section id="how-it-works">
      <div
        class="mx-auto grid w-full max-w-300 gap-16 px-6 py-24 md:px-10 md:py-32 lg:px-16"
      >
        <div>
          <span
            class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
            >Comment ça fonctionne ?</span
          >
          <FadeInBlurWord
            as="h2"
            className="max-w-lg font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
            content={[
              { text: "Un prompt, " },
              {
                text: "trois étapes.",
                style: { color: "rgb(133, 133, 133)" },
              },
            ]}
            client:load
          />
        </div>

        <HowItWorksTab client:load />
      </div>
    </section>

    <section
      id="benefits"
      class="mx-auto w-full max-w-300 px-6 py-24 md:px-10 md:py-32 lg:px-16"
    >
      <div class="mb-14 max-w-3xl">
        <span
          class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
          >Les avantages</span
        >
        <FadeInBlurWord
          as="h2"
          content={[
            {
              text: "Une puissance invisible à vos côtés, qui vous apporte des avantages concrets au quotidien.",
            },
          ]}
          className="font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
          client:load
        />
      </div>

      <BenefitsCards benefits={benefits} client:load />
    </section>

    <section
      id="faq"
      class="mx-auto w-full max-w-250 px-6 py-24 md:px-10 md:py-32"
    >
      <div class="mb-12 text-center">
        <span
          class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45"
          >FAQ</span
        >
        <FadeInBlurWord
          as="h2"
          content={[{ text: "Vos questions, nos réponses" }]}
          className="font-sans text-3xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl"
          client:load
        />
      </div>

      <FAQs client:load />
    </section>

    <section id="final-cta" class="px-6 pb-24 md:px-10 md:pb-32 lg:px-16">
      <div
        class="mx-auto flex w-full max-w-300 flex-col border border-white/10 bg-white/2.5 px-6 py-20 md:px-10 md:py-28"
        style=`
          border-radius: inherit;
          corner-shape: inherit;
          background-image: url(${headerImage.src});
          background-repeat: no-repeat;
          background-position: center center;
          background-size: cover;
          border: 0;`
      >
        <FadeInBlurWord
          as="h2"
          content={[{ text: "Essayez maintenant" }]}
          className="font-sans text-4xl font-normal leading-none tracking-[-0.03em] text-white sm:text-5xl"
          client:load
        />
        <FadeInBlurWord
          as="p"
          content={[
            {
              text: "Cette IA est actuellement proposée gratuitement, pourquoi ne pas la tester ?",
            },
          ]}
          className="mt-5 max-w-xl text-sm leading-7 text-white/55 sm:text-base"
          client:load
        />
        <a
          href={`${import.meta.env.BASE_URL}chat`}
          class="mt-8 w-26 inline-flex min-h-12 items-center justify-center rounded-full bg-[#e8ff9c] px-7 text-sm font-medium text-black transition hover:opacity-90"
        >
          Commencer
        </a>
      </div>
    </section>
  </main>
</Layout>
