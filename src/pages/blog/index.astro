---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import FadeInBlurWord from "@/components/animation/FadeInBlurWord";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog - SparksLyse"
  description="Découvrez les dernières actualités et réflexions sur l'IA open-source."
  ogImage="images/ogImage.jpg"
>
  <main class="mx-auto flex w-full max-w-300 flex-col gap-12 px-6 py-24 md:px-10 md:py-32 lg:px-16">
    <div class="max-w-4xl">
      <span class="mb-5 block text-xs uppercase tracking-[0.18em] text-white/45">
        Journal
      </span>
      <FadeInBlurWord
        as="h1"
        content={[
          { text: "Actualités & " },
          {
            text: "Réflexions",
            style: { color: "rgb(133, 133, 133)" },
          },
        ]}
        className="font-sans text-4xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-5xl lg:text-6xl justify-start"
        client:load
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        posts.map((post) => (
          <a
            href={`${import.meta.env.BASE_URL}blog/${post.id}/`}
            class="group flex flex-col p-6 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 transition-all duration-300"
          >
            <time class="text-[10px] uppercase tracking-widest text-white/40 mb-4">
              {post.data.pubDate.toLocaleDateString("fr-FR", { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <h2 class="text-xl font-normal text-white mb-3 group-hover:text-white transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm leading-relaxed text-white/50 line-clamp-3">
              {post.data.description}
            </p>
            <div class="mt-auto pt-6 flex items-center text-xs font-medium text-white opacity-0 group-hover:opacity-100 transition-opacity">
              Lire l'article
              <svg class="ml-2 w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
