---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="SparksLyse, l'IA Open-Source"
  description={`Tout les articles du blog`}
>
  <main
    class="flex flex-col items-center justify-center text-center text-white px-4"
  >
    {
      posts.map((post) => (
        <a
          href={`${import.meta.env.BASE_URL}blog/${post.id}/`}
          class="bg-[#0a0a0a]/30 flex rounded-md w-fit px-10 py-5 text-center justify-center mt-6"
        >
          <h2 class="pr-5 text-xl">{post.data.title}</h2>
          <p class="pr-4">{post.data.description}</p>
          <time class="text-sm">{post.data.pubDate.toLocaleDateString("fr-FR")}</time>
        </a>
      ))
    }
  </main>
</Layout>
