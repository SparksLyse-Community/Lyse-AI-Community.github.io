---
import LiveImage from "../components/LiveImage";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="L'Entraînement en temps réel"
  description="De SparksLyse, quand l'IA rencontre l'Open-Source"
>
  <main class="items-center text-center text-white" >
    <div
      style="
        height: 80%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        "
    >
      <LiveImage imageUrl="https://marvideo.fr/lyseai-api/status.php" alt="Entrainement en temps reel" client:load />
    </div>
  </main>
</Layout>
