---
interface Props {
  title?: string;
  description?: string;
  ogSlug?: string;
}

const {
  title = "SparksLyse, l'IA Open-Source",
  description = "Quand l'IA rencontre l'Open-Source",
} = Astro.props;

const siteUrl = Astro.url;

const pathname = Astro.url.pathname;

const ogName =
  pathname === "/"
    ? "home"
    : pathname
        .replace(/^\/|\/$/g, "")
        .replaceAll("/", "-")
        .replace(/[^a-zA-Z0-9-_]/g, "-");

const ogImage = `${siteUrl}/og/${ogName}.png`;

import "../styles/global.css";
import "../styles/fonts.css";

import noise from "../assets/images/noise.png";
import Navbar from "../components/Navbar";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <meta name="description" content={description} />

    <link rel="canonical" href={siteUrl.href} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}logo.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}logo.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl.href} />

    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <meta name="robots" content="max-image-preview:large" />
  </head>

  <body class="min-h-screen overflow-x-hidden bg-[#0a0a0a] text-white">
    <Navbar client:load />
    <slot />

    <footer
      class="relative
        z-10
        border-t
        border-white/10
        px-4
        py-8
  
        sm:px-6
        sm:py-10
  
        md:px-10
  
        lg:px-16"
    >
      <div
        class="mx-auto
          grid
          w-full
          max-w-300
          gap-8
  
          md:grid-cols-[1fr_auto]
          md:items-end
          md:gap-10"
      >
        <div>
          <a
            href={`${import.meta.env.BASE_URL}#hero`}
            class="text-base
              font-medium
              text-white
              transition-opacity
              hover:opacity-80"
          >
            SparksLyse
          </a>

          <p class="mt-2 text-sm text-white/45">
            L'IA intelligente open-source
          </p>
        </div>

        <nav
          aria-label="Navigation du pied de page"
          class="flex
            flex-wrap
            gap-x-5
            gap-y-3
            text-sm
            text-white/55
  
            sm:gap-x-6"
        >
          <a
            href={`${import.meta.env.BASE_URL}#about`}
            class="transition hover:text-white"
          >
            A propos
          </a>

          <a
            href={`${import.meta.env.BASE_URL}#features`}
            class="transition hover:text-white"
          >
            Fonctionnalités
          </a>

          <a
            href={`${import.meta.env.BASE_URL}mentions-legales`}
            class="transition hover:text-white"
          >
            Mentions légales
          </a>

          <a
            href={`${import.meta.env.BASE_URL}politique-confidentialite`}
            class="transition hover:text-white"
          >
            Confidentialité
          </a>

          <a
            href={`${import.meta.env.BASE_URL}politique-cookies`}
            class="transition hover:text-white"
          >
            Cookies
          </a>

          <a
            href={`${import.meta.env.BASE_URL}cgu`}
            class="transition hover:text-white"
          >
            CGU
          </a>

          <a
            href="https://github.com/SparksLyse-Community"
            target="_blank"
            rel="noreferrer"
            class="transition hover:text-white"
          >
            Github
          </a>

          <a
            href={`${import.meta.env.BASE_URL}#faq`}
            class="transition hover:text-white"
          >
            FAQ
          </a>
        </nav>
      </div>
    </footer>

    <div
      class="pointer-events-none
        fixed
        inset-0
        z-[-1]
        overflow-hidden
        opacity-[0.13]
        select-none"
      aria-hidden="true"
    >
      <div
        class="absolute
          inset-0
          bg-repeat
          bg-center"
        style={`
          background-image: url(${noise.src});
          background-size: 153.5px auto;
        `}
      >
      </div>
    </div>
  </body>
</html>
